# cp .env.example .env 후 값을 채운다. .env는 커밋하지 않는다.
# 로컬 npm run ... 과 docker compose 모두 이 파일을 읽는다. 셸에 이미 설정된 값이 우선한다.
# 빈 값은 미설정으로 처리된다.

# ── 에이전트 LLM (browser-use 크롤링) ─────────────────────────
# anthropic | openai | openai-compatible
AGENT_LLM_PROVIDER=
# anthropic이면 비워도 claude-opus-5-5. 다른 공급사는 필수
AGENT_LLM_MODEL=
AGENT_LLM_API_KEY=
# openai-compatible이면 필수. 예: https://api.siliconflow.com/v1
AGENT_LLM_BASE_URL=

# ── 별칭·약관 추출 LLM (src/aliases.ts, src/extract.ts) ──────
# ALIAS_LLM_PROVIDER를 비우면 아래 네 값은 무시되고 AGENT_LLM_* 설정을 그대로 쓴다.
# 지정하면 AGENT_LLM_*를 상속하지 않으므로 모델·키(·base URL)를 모두 채운다.
ALIAS_LLM_PROVIDER=
ALIAS_LLM_MODEL=
ALIAS_LLM_API_KEY=
ALIAS_LLM_BASE_URL=
# 예: 별칭만 SiliconFlow로
# ALIAS_LLM_PROVIDER=openai-compatible
# ALIAS_LLM_MODEL=Qwen/Qwen3-32B
# ALIAS_LLM_API_KEY=
# ALIAS_LLM_BASE_URL=https://api.siliconflow.com/v1

# ── 실행 옵션 ────────────────────────────────────────────────
# 비우면 https://sign-service.inicis.com/sample/request.php?reqSvcCd=03
START_URL=
# true면 별칭 캐시(data/alias-cache.json)를 무시하고 전부 다시 질의
ALIAS_REFRESH=true
MAX_STEPS=60

# ── 브라우저 ─────────────────────────────────────────────────
# true면 headless, false면 브라우저 창을 띄운다.
# - 로컬: 이 줄을 지우면 화면 유무를 감지해 정한다 (macOS는 창을 띄움). 빈 값(BROWSER_USE_HEADLESS=)은 false로 읽힌다.
# - Docker app 서비스: 비우면 true. false면 http://localhost:6080 에서 화면을 본다.
#   (headful 서비스는 이 값과 상관없이 항상 false)
BROWSER_USE_HEADLESS=true
# headful일 때 가상 디스플레이 크기 (가로x세로x색심도)
SCREEN_SIZE=1920x1080x24
